# Copy this file to .env.local to enable mock-data mode while the backend is
# unreachable. Do not commit .env.local — it's gitignored by Next.js defaults.

# Backend base URL. Defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to bypass live HTTP calls and serve mock fixtures from
# lib/api.ts. Leave unset (or any other value) to hit the FastAPI backend.
# Default in committed code is OFF so CI catches contract drift; flip ON
# locally while the FastAPI server isn't running.
NEXT_PUBLIC_MOCK_MODE=true
