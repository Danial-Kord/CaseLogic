ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./app.db
VECTOR_INDEX_PATH=./data/index

# Chat agent (POST /chat). Required for the chat surface to call Claude.
# CHAT_MODEL defaults to claude-sonnet-4-6 if unset.
CHAT_MODEL=
CHAT_HISTORY_CAP=30
CHAT_MAX_STEPS=6

# Firecrawl powers the chat agent's web_search tool. Without a key the tool
# returns an empty result + an explanatory note (the agent then falls back
# to local statute search rather than fabricating).
FIRECRAWL_API_KEY=
# Comma-separated domain whitelist. Defaults to authoritative legal sources.
# Patterns: bare host = exact match, '*.tld' = any subdomain of that TLD.
FIRECRAWL_ALLOWED_DOMAINS=leginfo.legislature.ca.gov,courtlistener.com,scholar.google.com,*.gov,*.edu
